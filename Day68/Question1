#include <stdio.h>

int main() {
    int n;

    // Input the size of the array
    printf("Enter the size of the array (n): ");
    scanf("%d", &n);

    int arr[n];
    int actual_sum = 0;

    // Input array elements and calculate their sum
    printf("Enter %d elements (numbers from 0 to %d with one missing):\n", n, n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        actual_sum += arr[i];
    }

    // Expected sum of integers from 0 to n is n * (n + 1) / 2
    int expected_sum = n * (n + 1) / 2;

    // The difference gives the missing number
    int missing_number = expected_sum - actual_sum;

    printf("The missing number is: %d\n", missing_number);

    return 0;
}

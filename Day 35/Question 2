#include <stdio.h>

void reverse(int arr[], int start, int end) {
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
  }
void rotateRight(int arr[], int n, int k) {
    if (n <= 1) return; // No rotation needed for empty or single-element arrays
    
    k = k % n;          // Handle cases where k is greater than the array size
    if (k == 0) return; // No rotation needed

    reverse(arr, n - k, n - 1);

    reverse(arr, 0, n - k - 1);

    reverse(arr, 0, n - 1);
}

int main() {
    int arr[] = {1, 2, 3, 4, 5, 6, 7};
    int n = sizeof(arr) / sizeof(arr[0]);
    int k = 3;

    printf("Original array: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    rotateRight(arr, n, k);

    printf("Rotated array by %d positions: ", k);
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}

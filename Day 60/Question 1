#include <stdio.h>

void printMaxOfSubarrays(int arr[], int n, int k) {
    // Loop through each starting index of the subarray of size k
    for (int i = 0; i <= n - k; i++) {
        int maxVal = arr[i];
        
        // Find the maximum element in the current subarray from i to i + k - 1
        for (int j = 1; j < k; j++) {
            if (arr[i + j] > maxVal) {
                maxVal = arr[i + j];
            }
        }
        
        // Print the maximum element followed by a space
        printf("%d ", maxVal);
    }
    printf("\n");
}

int main() {
    int n, k;

    // Read the size of the array
    printf("Enter the number of elements in the array: ");
    if (scanf("%d", &n) != 1 || n <= 0) return 0;

    int arr[n];
    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Read the window size k
    printf("Enter the window size k: ");
    if (scanf("%d", &k) != 1 || k <= 0 || k > n) return 0;

    printf("Maximum elements in each window of size %d:\n", k);
    printMaxOfSubarrays(arr, n, k);

    return 0;
}

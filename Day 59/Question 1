#include <stdio.h>

int main() {
    int n, k;

    // 1. Take array size and window size k as input
    printf("Enter the number of elements in the array: ");
    scanf("%d", &n);

    printf("Enter the value of k: ");
    scanf("%d", &k);

    // Validate inputs
    if (k > n || k <= 0) {
        printf("Invalid value of k. It must be between 1 and %d.\n", n);
        return 1;
    }

    int arr[n];
    printf("Enter %d elements of the array:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // 2. Compute the sum of the first window of size k
    int current_sum = 0;
    for (int i = 0; i < k; i++) {
        current_sum += arr[i];
    }

    int max_sum = current_sum;

    // 3. Slide the window across the remaining elements of the array
    for (int i = k; i < n; i++) {
        // Add the incoming element and subtract the outgoing element
        current_sum += arr[i] - arr[i - k];
        
        // Update max_sum if the current window sum is higher
        if (current_sum > max_sum) {
            max_sum = current_sum;
        }
    }

    // 4. Print the final result
    printf("The maximum sum of a subarray of size %d is: %d\n", k, max_sum);

    return 0;
}

#include <stdio.h>

// Define the enum for user roles
enum UserRole {
    ADMIN,
    USER,
    GUEST
};

// Function to display a message based on the role
void displayRoleMessage(enum UserRole role) {
    switch (role) {
        case ADMIN:
            printf("Welcome, Admin! You have full access to the system.\n");
            break;
        case USER:
            printf("Welcome back, User! You can view and edit your profile.\n");
            break;
        case GUEST:
            printf("Welcome, Guest! Please sign up or log in for more features.\n");
            break;
        default:
            printf("Invalid role.\n");
            break;
    }
}

int main() {
    // Example usage
    enum UserRole currentUser = ADMIN;
    displayRoleMessage(currentUser);

    currentUser = GUEST;
    displayRoleMessage(currentUser);

    return 0;
}

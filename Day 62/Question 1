#include <stdio.h>

// Function to find the maximum sum of a contiguous subarray
int maxSubarraySum(int arr[], int n) {
    // Initialize both tracking variables with the first element
    int max_so_far = arr[0];
    int max_ending_here = arr[0];

    for (int i = 1; i < n; i++) {
        // Decide whether to add the current element to the existing subarray
        // or start a new subarray from the current element
        if (arr[i] > max_ending_here + arr[i]) {
            max_ending_here = arr[i];
        } else {
            max_ending_here = max_ending_here + arr[i];
        }

        // Update the overall maximum sum found so far
        if (max_ending_here > max_so_far) {
            max_so_far = max_ending_here;
        }
    }

    return max_so_far;
}

int main() {
    int n;

    // Take the size of the array as input
    printf("Enter the number of elements in the array: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid array size.\n");
        return 1;
    }

    int arr[n];

    // Take the array elements as input
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Calculate and print the maximum contiguous subarray sum
    int max_sum = maxSubarraySum(arr, n);
    printf("The maximum sum of any contiguous subarray is: %d\n", max_sum);

    return 0;
}

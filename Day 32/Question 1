#include <stdio.h>

int main() {
    int arr1[] = {1, 3, 5};
    int arr2[] = {2, 4, 6, 8};

    int len1 = sizeof(arr1) / sizeof(arr1[0]);
    int len2 = sizeof(arr2) / sizeof(arr2[0]);
    int lenResult = len1 + len2;

    int result[lenResult];

    for (int i = 0; i < len1; i++) {
        result[i] = arr1[i];
    }

    for (int i = 0; i < len2; i++) {
        result[len1 + i] = arr2[i];
    }

    printf("Merged Array: ");
    for (int i = 0; i < lenResult; i++) {
        printf("%d ", result[i]);
    }
    
    return 0;
}

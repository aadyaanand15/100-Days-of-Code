#include <stdio.h>

int main() {
    int arr[100] = {10, 20, 30, 40, 50}; 
    int size = 5; // Current number of elements
    
    int element = 25; // Element to insert
    int pos = 2;      // Index position where we want to insert (0-based indexing)

    printf("Original array: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    for (int i = size; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos] = element;

    size++;

    printf("Array after insertion: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}

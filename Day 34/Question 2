#include <stdio.h>

int deleteElement(int arr[], int size, int index) {
    if (index < 0 || index >= size) {
        printf("Error: Invalid index %d. Deletion not possible.\n", index);
        return size; // Return original size if nothing was deleted
    }

    for (int i = index; i < size - 1; i++) {
        arr[i] = arr[i + 1];
    }

    return size - 1;
}

int main() {
    int arr[10] = {10, 20, 30, 40, 50}; // Fixed-size array
    int size = 5;                       // Current number of elements inside it
    int indexToDelete = 2;              // Index of the element we want to remove (30)

    printf("Original array: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    size = deleteElement(arr, size, indexToDelete);

    printf("Array after deletion: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}

#include <stdio.h>
#include <stdlib.h>

void printFirstNegative(int arr[], int n, int k) {
    // Create a temporary array/queue to store indices of negative elements
    int* queue = (int*)malloc(n * sizeof(int));
    int front = 0, rear = 0;

    // Process the first window of size k
    for (int i = 0; i < k; i++) {
        if (arr[i] < 0) {
            queue[rear++] = i;
        }
    }

    // Print the result for the first window
    if (front < rear) {
        printf("%d ", arr[queue[front]]);
    } else {
        printf("0 ");
    }

    // Process the remaining windows
    for (int i = k; i < n; i++) {
        // Remove indices that are out of the current window
        while (front < rear && queue[front] <= (i - k)) {
            front++;
        }

        // Add current element if it is negative
        if (arr[i] < 0) {
            queue[rear++] = i;
        }

        // Print the result for the current window
        if (front < rear) {
            printf("%d ", arr[queue[front]]);
        } else {
            printf("0 ");
        }
    }
    printf("\n");

    // Free allocated memory
    free(queue);
}

int main() {
    int n, k;

    // Input the size of the array
    printf("Enter the number of elements in the array: ");
    if (scanf("%d", &n) != 1) return 1;

    int* arr = (int*)malloc(n * sizeof(int));

    // Input the array elements
    printf("Enter the elements of the array:\n");
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) return 1;
    }

    // Input the window size k
    printf("Enter the window size k: ");
    if (scanf("%d", &k) != 1) return 1;

    // Boundary check
    if (k > n || k <= 0) {
        printf("Invalid window size.\n");
        free(arr);
        return 1;
    }

    // Find and print the first negative integer in each window
    printf("Output:\n");
    printFirstNegative(arr, n, k);

    free(arr);
    return 0;
}

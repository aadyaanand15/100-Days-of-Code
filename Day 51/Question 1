#include <stdio.h>

// Function to find the first occurrence using binary search
int findFirst(int nums[], int size, int target) {
    int start = 0, end = size - 1;
    int firstIndex = -1;
    
    while (start <= end) {
        int mid = start + (end - start) / 2;
        
        if (nums[mid] == target) {
            firstIndex = mid; // Potential answer found
            end = mid - 1;    // Keep searching on the left side
        } else if (nums[mid] < target) {
            start = mid + 1;
        } else {
            end = mid - 1;
        }
    }
    return firstIndex;
}

// Function to find the last occurrence using binary search
int findLast(int nums[], int size, int target) {
    int start = 0, end = size - 1;
    int lastIndex = -1;
    
    while (start <= end) {
        int mid = start + (end - start) / 2;
        
        if (nums[mid] == target) {
            lastIndex = mid;  // Potential answer found
            start = mid + 1;  // Keep searching on the right side
        } else if (nums[mid] < target) {
            start = mid + 1;
        } else {
            end = mid - 1;
        }
    }
    return lastIndex;
}

int main() {
    int n, target;

    // Input the size of the array
    printf("Enter the number of elements in the sorted array: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("-1, -1\n");
        return 0;
    }

    int nums[n];

    // Input the sorted array elements
    printf("Enter %d sorted elements (can have repetitions):\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }

    // Input the target element to search for
    printf("Enter the target element: ");
    scanf("%d", &target);

    // Find first and last occurrences
    int first = findFirst(nums, n, target);
    int last = findLast(nums, n, target);

    // Print the results
    printf("%d, %d\n", first, last);

    return 0;
}

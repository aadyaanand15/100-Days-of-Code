#include <stdio.h>
#include <math.h>

int main() {
    double a, b, c;
    double discriminant, root1, root2, realPart, imagPart;

    printf("Enter coefficients a, b and c: ");
    if (scanf("%lf %lf %lf", &a, &b, &c) != 3) {
        printf("Error: Invalid input.\n");
        return 1;
    }
    if (a == 0) {
        if (b == 0) {
            printf("Invalid equation: No roots exist (0 = %lf).\n", c);
        } else {
            printf("Linear equation detected. Single root: %.2lf\n", -c / b);
        }
        return 0;
    }

    discriminant = (b * b) - (4 * a * c);

    if (discriminant > 0) {
        // Condition 1: Real and Distinct Roots
        root1 = (-b + sqrt(discriminant)) / (2 * a);
        root2 = (-b - sqrt(discriminant)) / (2 * a);
        
        printf("Root categorization: Real and Distinct\n");
        printf("Root 1 = %.2lf\n", root1);
        printf("Root 2 = %.2lf\n", root2);
    } 
    else if (discriminant == 0) {
        // Condition 2: Real and Equal Roots
        root1 = root2 = -b / (2 * a);
        
        printf("Root categorization: Real and Equal\n");
        printf("Root 1 = Root 2 = %.2lf\n", root1);
    } 
        realPart = -b / (2 * a);
        imagPart = sqrt(-discriminant) / (2 * a);
        
        printf("Root categorization: Complex (Imaginary)\n");
        printf("Root 1 = %.2lf + %.2lfi\n", realPart, imagPart);
        printf("Root 2 = %.2lf - %.2lfi\n", realPart, imagPart);
    }

    return 0;
}

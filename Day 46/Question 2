#include <stdio.h>
#include <string.h>

char findFirstRepeating(char *str) {
    int visited[26] = {0};

    for (int i = 0; str[i] != '\0'; i++) {
        // Only process lowercase letters
        if (str[i] >= 'a' && str[i] <= 'z') {
            int index = str[i] - 'a'; // Map 'a' -> 0, 'b' -> 1, ..., 'z' -> 25

            if (visited[index] > 0) {
                return str[i];
            }

            visited[index]++;
        }
    }

    return '\0'; 
}

int main() {
    char str[100];

    printf("Enter a string: ");
    scanf("%99[^\n]", str); 

    char result = findFirstRepeating(str);

    if (result != '\0') {
        printf("The first repeating lowercase alphabet is: '%c'\n", result);
    } else {
        printf("No repeating lowercase alphabets found.\n");
    }

    return 0;
}

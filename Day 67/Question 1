#include <stdio.h>

int main() {
    int m, n;

    // Input size and elements of the first sorted array
    printf("Enter the size of the first array (m): ");
    scanf("%d", &m);
    int arr1[m];
    printf("Enter %d sorted elements for the first array: ", m);
    for (int i = 0; i < m; i++) {
        scanf("%d", &arr1[i]);
    }

    // Input size and elements of the second sorted array
    printf("Enter the size of the second array (n): ");
    scanf("%d", &n);
    int arr2[n];
    printf("Enter %d sorted elements for the second array: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr2[i]);
    }

    int merged[m + n];
    int i = 0, j = 0, k = 0;

    // Compare elements from both arrays and copy the smaller one
    while (i < m && j < n) {
        if (arr1[i] <= arr2[j]) {
            merged[k++] = arr1[i++];
        } else {
            merged[k++] = arr2[j++];
        }
    }

    // Copy any remaining elements from arr1
    while (i < m) {
        merged[k++] = arr1[i++];
    }

    // Copy any remaining elements from arr2
    while (j < n) {
        merged[k++] = arr2[j++];
    }

    // Print the merged sorted array
    printf("Merged sorted array: ");
    for (int idx = 0; idx < m + n; idx++) {
        printf("%d ", merged[idx]);
    }
    printf("\n");

    return 0;
}

#include <stdio.h>
#include <stdlib.h>

// Function to find the majority element
int findMajorityElement(int nums[], int n) {
    int candidate = -1;
    int count = 0;

    // Step 1: Find a potential majority candidate
    for (int i = 0; i < n; i++) {
        if (count == 0) {
            candidate = nums[i];
            count = 1;
        } else if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }

    // Step 2: Verify if the candidate is strictly greater than n / 2
    int actualCount = 0;
    for (int i = 0; i < n; i++) {
        if (nums[i] == candidate) {
            actualCount++;
        }
    }

    if (actualCount > n / 2) {
        return candidate;
    } else {
        return -1; // No majority element exists
    }
}


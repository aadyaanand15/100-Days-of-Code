#include <stdio.h>

int main() {
    int n, target;

    // Read the size of the array
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int nums[n];

    // Read the elements of the array
    for (int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }

    // Read the target sum
    scanf("%d", &target);

    // Search for two distinct indices whose values add up to target
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (nums[i] + nums[j] == target) {
                printf("%d %d\n", i, j);
                return 0;
            }
        }
    }

    // If no solution exists
    printf("-1 -1\n");
    return 0;
}

#include <stdio.h>
#include <string.h>

// Function to print all substrings of a given string
void printAllSubstrings(char str[]) {
    int n = strlen(str);

    // Pick starting point of the substring
    for (int i = 0; i < n; i++) {
        // Pick ending point of the substring
        for (int j = i; j < n; j++) {
            // Print characters from the current starting point 'i' to ending point 'j'
            for (int k = i; k <= j; k++) {
                printf("%c", str[k]);
            }
            printf("\n"); // Move to the next line for the next substring
        }
    }
}

int main() {
    char str[] = "abcd";
    
    printf("All substrings of \"%s\" are:\n", str);
    printAllSubstrings(str);
    
    return 0;
}

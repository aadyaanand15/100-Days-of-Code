#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *file;
    char filename[100];
    int ch;
    long characters = 0, words = 0, lines = 0;
    int in_word = 0; // State flag: 1 if currently inside a word, 0 otherwise

    printf("Enter the file name: ");
    scanf("%99s", filename);

    // Open the file in read mode
    file = fopen(filename, "r");
    if (file == NULL) {
        printf("Error: Could not open file %s\n", filename);
        return 1;
    }

    // Read file character by character until End of File (EOF)
    while ((ch = fgetc(file)) != EOF) {
        characters++;

        // Count newline characters
        if (ch == '\n') {
            lines++;
        }

        // Check for word delimiters (space, newline, or carriage return)
        if (ch == ' ' || ch == '\n' || ch == '\r') {
            in_word = 0;
        } else if (in_word == 0) {
            // Transitioned from whitespace to a non-space character
            in_word = 1;
            words++;
        }
    }

    // Account for the last line if the file is not empty and doesn't end with '\n'
    if (characters > 0 && ch != '\n') {
        lines++;
    }

    fclose(file);

    printf("\nTotal Characters: %ld\n", characters);
    printf("Total Words:      %ld\n", words);
    printf("Total Lines:      %ld\n", lines);

    return 0;
}

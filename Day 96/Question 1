#include <stdio.h>

// Define the nested Date structure
struct Date {
    int day;
    int month;
    int year;
};

// Define the Employee structure containing Date
struct Employee {
    int id;
    char name[50];
    float salary;
    struct Date joiningDate; // Nested structure variable
};

int main() {
    // Declare and initialize an Employee variable
    struct Employee emp = {101, "Aarav Sharma", 55000.50, {15, 8, 2024}};

    // Print Employee details
    printf("--- Employee Details ---\n");
    printf("ID           : %d\n", emp.id);
    printf("Name         : %s\n", emp.name);
    printf("Salary       : %.2f\n", emp.salary);
    printf("Joining Date : %02d/%02d/%d\n", 
           emp.joiningDate.day, 
           emp.joiningDate.month, 
           emp.joiningDate.year);

    return 0;
}

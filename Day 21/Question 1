#include <stdio.h>

int main()
{
    int n, first, last, digits = 0, power, middle, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    first = n;

    while (first >= 10)
    {
        first = first / 10;
        digits++;
    }

    last = n % 10;

    power = 1;
    for (int i = 1; i <= digits; i++)
    {
        power = power * 10;
    }

    middle = (n % power) / 10;

    result = last * power + middle * 10 + first;

    printf("Number after swapping first and last digit = %d", result);

    return 0;
}

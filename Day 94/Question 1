#include <stdio.h>

// 1. Define the structure
struct Student {
    int id;
    char name[50];
    float gpa;
};

// 2. Function that accepts the structure and prints its members
void printStudent(struct Student s) {
    printf("ID: %d\n", s.id);
    printf("Name: %s\n", s.name);
    printf("GPA: %.2f\n", s.gpa);
}

int main() {
    // Initialize a structure variable
    struct Student s1 = {101, "Aarav Sharma", 8.9};

    // Pass the structure to the function
    printStudent(s1);

    return 0;
}

#include <stdio.h>

int main() {
    int n;

    // Taking the size of the array as input
    printf("Enter the number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n];

    // Taking array elements as input
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Brute force logic to find the Next Greater Element (NGE)
    for (int i = 0; i < n; i++) {
        int nextGreater = -1; // Default if no greater element is found

        // Nested loop to look at elements to the right
        for (int j = i + 1; j < n; j++) {
            if (arr[j] > arr[i]) {
                nextGreater = arr[j];
                break; // Stop at the nearest greater element
            }
        }

        // Print the output in a comma-separated fashion
        if (i == n - 1) {
            printf("%d", nextGreater); // No trailing comma for the last element
        } else {
            printf("%d, ", nextGreater);
        }
    }

    printf("\n");
    return 0;
}

#include <stdio.h>

void findPreviousGreater(int arr[], int n) {
    // Loop through each element of the array
    for (int i = 0; i < n; i++) {
        int prevGreater = -1;

        // Traverse elements to the left of the current element
        for (int j = i - 1; j >= 0; j--) {
            if (arr[j] > arr[i]) {
                prevGreater = arr[j];
                break; // Found the nearest greater element on the left
            }
        }

        // Print the result in a comma-separated fashion
        if (i == n - 1) {
            printf("%d", prevGreater); // No trailing comma for the last element
        } else {
            printf("%d, ", prevGreater);
        }
    }
    printf("\n");
}

int main() {
    int n;

    // Input the size of the array
    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n];

    // Input array elements
    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Process and print previous greater elements
    printf("Output: ");
    findPreviousGreater(arr, n);

    return 0;
}

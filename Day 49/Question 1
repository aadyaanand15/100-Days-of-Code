#include <stdio.h>
#include <string.h>
#include <ctype.h>

void printInitials(char *name) {
    int len = strlen(name);
    
    if (len == 0) {
        return;
    }

    if (isalpha(name[0])) {
        printf("%c", toupper(name[0]));
    }

    for (int i = 1; i < len; i++) {
        if (name[i - 1] == ' ' && name[i] != ' ' && isalpha(name[i])) {
            printf(" %c", toupper(name[i]));
        }
    }
    printf("\n");
}

int main() {
    char name[100];

    printf("Enter your full name: ");
    scanf("%[^\n]s", name);

    printf("Your initials are: ");
    printInitials(name);

    return 0;
}

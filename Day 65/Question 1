#include <stdio.h>
#include <string.h>

#define MAX_LEN 100005

int isAnagram(const char *s, const char *t) {
    size_t len_s = strlen(s);
    size_t len_t = strlen(t);

    if (len_s != len_t) {
        return 0;
    }

    int freq[26] = {0};

    for (size_t i = 0; i < len_s; i++) {
        freq[s[i] - 'a']++;
        freq[t[i] - 'a']--;
    }

    for (int i = 0; i < 26; i++) {
        if (freq[i] != 0) {
            return 0;
        }
    }

    return 1;
}

int main(void) {
    char s[MAX_LEN], t[MAX_LEN];

    if (scanf("%100004s %100004s", s, t) != 2) {
        printf("Not Anagram\n");
        return 0;
    }

    if (isAnagram(s, t)) {
        printf("Anagram\n");
    } else {
        printf("Not Anagram\n");
    }

    return 0;
}
